FROM guacamole/guacamole:1.5.5

# Copy print extension resources to CORRECT locations
COPY guacamole-extension-module/src/main/resources/js/print-agent-client.js /home/guacamole/tomcat/webapps/guacamole/
COPY guacamole-extension-module/src/main/resources/css/print-agent.css /home/guacamole/tomcat/webapps/guacamole/

# Create modified index.html that includes print agent
RUN cat /home/guacamole/tomcat/webapps/guacamole/index.html | \
    sed 's|<script src="app.js?b=.*</script>|<script src="print-agent-client.js"></script>\n<link rel="stylesheet" href="print-agent.css">\n&|' \
    > /home/guacamole/tomcat/webapps/guacamole/index.html.new && \
    mv /home/guacamole/tomcat/webapps/guacamole/index.html.new /home/guacamole/tomcat/webapps/guacamole/index.html

# Ensure proper permissions
RUN chown guacamole:guacamole /home/guacamole/tomcat/webapps/guacamole/print-agent-client.js
RUN chown guacamole:guacamole /home/guacamole/tomcat/webapps/guacamole/print-agent.css
RUN chown guacamole:guacamole /home/guacamole/tomcat/webapps/guacamole/index.html

# Expose port 8080
EXPOSE 8080

# Start Guacamole normally
CMD ["/opt/guacamole/bin/start.sh"]
