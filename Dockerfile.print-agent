# ==================== GUACAMOLE PRINT AGENT SERVER ====================
# Lightweight Docker image for WebSocket print agent server

FROM node:18-alpine

# Create app directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install --production

# Copy print agent server
COPY print-agent-server.js ./

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S printagent -u 1001

# Change ownership
RUN chown -R printagent:nodejs /app
USER printagent

# Expose port
EXPOSE 8182

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8182/health || exit 1

# Start the server
CMD ["node", "print-agent-server.js"]