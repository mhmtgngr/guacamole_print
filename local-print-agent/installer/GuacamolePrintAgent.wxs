<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">

  <Package Name="Guacamole Print Agent"
           Manufacturer="Guacamole Print Solution"
           Version="2.12.0.0"
           UpgradeCode="B748B3C5-C676-4B01-83F6-6D8DEE89DFE4"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Guacamole Print Agent is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Install directory -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="GuacamolePrintAgent">

        <!-- Main executable -->
        <Component Id="MainExecutable" Guid="ECC680FD-A314-4BE0-817B-F30181563D73">
          <File Id="AgentExe" Source="GuacamolePrintAgent.exe" KeyPath="yes" />

          <!-- Firewall rule for port 8181 -->
          <fw:FirewallException Id="FwRule"
                                Name="Guacamole Print Agent"
                                Protocol="tcp"
                                Port="8181"
                                Scope="localSubnet"
                                Profile="all" />
        </Component>

        <!-- Config file -->
        <Component Id="ConfigFile" Guid="D299CF60-D633-41DC-9900-6908AB52454A">
          <File Id="AppSettings" Source="appsettings.json" KeyPath="yes" />
        </Component>

        <!-- Hidden launcher VBS -->
        <Component Id="HiddenLauncher" Guid="A1B2C3D4-E5F6-7890-ABCD-EF0123456789">
          <File Id="StartHiddenVbs" Source="StartHidden.vbs" KeyPath="yes" />

          <!-- Auto-start on login (all users) -->
          <RegistryValue Root="HKLM"
                         Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
                         Name="GuacamolePrintAgent"
                         Type="string"
                         Value="wscript.exe &quot;[INSTALLFOLDER]StartHidden.vbs&quot;"
                         KeyPath="no" />
        </Component>

        <!-- Uninstall batch -->
        <Component Id="UninstallBat" Guid="F9E8D7C6-B5A4-3210-FEDC-BA9876543210">
          <File Id="UninstallFile" Source="Uninstall.bat" KeyPath="yes" />
        </Component>

        <!-- Defender setup/remove scripts -->
        <Component Id="DefenderScripts" Guid="C3D4E5F6-A7B8-9012-CDEF-345678901234">
          <File Id="DefenderSetupBat" Source="DefenderSetup.bat" KeyPath="yes" />
          <File Id="DefenderRemoveBat" Source="DefenderRemove.bat" />
          <File Id="DefenderSetupVbs" Source="DefenderSetup.vbs" />
          <File Id="DefenderRemoveVbs" Source="DefenderRemove.vbs" />
        </Component>

      </Directory>
    </StandardDirectory>

    <!-- System directory for wscript.exe -->
    <StandardDirectory Id="System64Folder" />

    <!-- Feature -->
    <Feature Id="Complete" Title="Guacamole Print Agent" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="ConfigFile" />
      <ComponentRef Id="HiddenLauncher" />
      <ComponentRef Id="UninstallBat" />
      <ComponentRef Id="DefenderScripts" />
    </Feature>

    <!-- Stop agent before uninstall/upgrade so files are unlocked -->
    <CustomAction Id="StopAgent"
                  Directory="System64Folder"
                  ExeCommand="cmd.exe /c &quot;taskkill /IM GuacamolePrintAgent.exe /F &amp; timeout /t 2 /nobreak&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- Add Defender exclusions on install (VBS ShellExecute runas for proper elevation) -->
    <CustomAction Id="AddDefenderExclusions"
                  Directory="System64Folder"
                  ExeCommand="wscript.exe &quot;[INSTALLFOLDER]DefenderSetup.vbs&quot;"
                  Execute="immediate"
                  Return="asyncNoWait" />

    <!-- Remove Defender exclusions on uninstall -->
    <CustomAction Id="RemoveDefenderExclusions"
                  Directory="System64Folder"
                  ExeCommand="wscript.exe &quot;[INSTALLFOLDER]DefenderRemove.vbs&quot;"
                  Execute="immediate"
                  Return="asyncNoWait" />

    <!-- Launch agent after install -->
    <CustomAction Id="LaunchAgent"
                  Directory="System64Folder"
                  ExeCommand="wscript.exe &quot;[INSTALLFOLDER]StartHidden.vbs&quot;"
                  Execute="immediate"
                  Return="asyncNoWait" />

    <InstallExecuteSequence>
      <!-- Stop agent before removing files (runs on uninstall and upgrade) -->
      <Custom Action="StopAgent" Before="RemoveFiles" Condition="REMOVE OR WIX_UPGRADE_DETECTED" />
      <!-- Remove Defender exclusions before uninstall -->
      <Custom Action="RemoveDefenderExclusions" After="StopAgent" Condition="REMOVE=&quot;ALL&quot;" />
      <!-- Add Defender exclusions after install is done -->
      <Custom Action="AddDefenderExclusions" After="InstallFinalize" Condition="NOT REMOVE" />
      <!-- Launch agent after Defender setup -->
      <Custom Action="LaunchAgent" After="AddDefenderExclusions" Condition="NOT REMOVE" />
    </InstallExecuteSequence>

  </Package>
</Wix>
