<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">

  <Bundle Name="Guacamole Print Agent Setup"
          Version="2.19.0.0"
          Manufacturer="Guacamole Print Solution"
          UpgradeCode="A1B2C3D4-5678-9ABC-DEF0-123456789ABC">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
        LicenseUrl=""
        Theme="hyperlinkLicense" />
    </BootstrapperApplication>

    <Chain>
      <MsiPackage SourceFile="GuacamolePrintAgent.msi"
                  DisplayName="Guacamole Print Agent"
                  Compressed="yes"
                  Vital="yes" />
    </Chain>

  </Bundle>
</Wix>
