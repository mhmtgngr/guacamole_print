FROM guacamole/guacamole:1.5.5

# Copy print extension resources
COPY guacamole-extension-module/src/main/resources/js/print-agent-client.js /opt/guacamole/webapp/
COPY guacamole-extension-module/src/main/resources/css/print-agent.css /opt/guacamole/webapp/

# Ensure webapps directory exists
RUN mkdir -p /opt/guacamole/tomcat/webapps/guacamole

# Copy enhanced index.html directly
COPY guacamole-extension-module/src/main/resources/index-enhanced.html /opt/guacamole/tomcat/webapps/guacamole/WEB-INF/index.html

# Expose port 8080
EXPOSE 8080