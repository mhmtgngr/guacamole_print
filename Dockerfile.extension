FROM guacamole/guacamole:1.5.5

# Copy extension JavaScript and CSS files directly into the webapp
COPY guacamole-extension-module/src/main/resources/js/print-agent-client.js /opt/guacamole/webapp/
COPY guacamole-extension-module/src/main/resources/css/print-agent.css /opt/guacamole/webapp/
COPY guacamole-extension-module/src/main/resources/index.html /opt/guacamole/webapp/
COPY guacamole-extension-module/src/main/resources/test.html /opt/guacamole/webapp/test.html
COPY guacamole-extension-module/src/main/resources/test.pdf /opt/guacamole/webapp/test.pdf

# Expose port 8080
EXPOSE 8080