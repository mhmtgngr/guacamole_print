<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.apache.guacamole</groupId>
    <artifactId>guacamole-print-agent-extension</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    
    <name>Guacamole Print Agent Extension</name>
    <description>Embedded JavaScript extension for Guacamole print agent integration</description>
    
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <guacamole.version>${guacamole.version}</guacamole.version>
    </properties>
    
    <dependencies>
        <!-- Guacamole Extension API -->
        <dependency>
            <groupId>org.apache.guacamole</groupId>
            <artifactId>guacamole-ext</artifactId>
            <version>${guacamole.version}</version>
            <scope>provided</scope>
        </dependency>
        
        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>1.7.36</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
    
    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                </configuration>
            </plugin>
            
            <!-- Copy Extension Resources -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>copy-resources</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/main/resources</directory>
                                    <includes>
                                        <include>**/*.js</include>
                                        <include>**/*.css</include>
                                        <include>**/*.html</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>${project.build.directory}/generated-sources</directory>
                                    <includes>
                                        <include>**/*.class</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            
            <!-- Package as Extension JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Guacamole-Extension-Class>org.apache.guacamole.printagent.extension.PrintAgentExtension</Guacamole-Extension-Class>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
    
    <profiles>
        <!-- Development Profile -->
        <profile>
            <id>dev</id>
            <properties>
                <guacamole.version>1.5.4</guacamole.version>
            </properties>
        </profile>
        
        <!-- Production Profile -->
        <profile>
            <id>prod</id>
            <properties>
                <guacamole.version>1.5.4</guacamole.version>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-minify-plugin</artifactId>
                        <version>1.3.0</version>
                        <executions>
                            <execution>
                                <id>minify-js</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>minify</goal>
                                </goals>
                                <configuration>
                                    <webappTargetPath>${project.build.directory}</webappTargetPath>
                                    <cssSourceDir>src/main/resources/css</cssSourceDir>
                                    <cssSourceIncludes>
                                        <include>**/*.css</include>
                                    </cssSourceIncludes>
                                    <cssFinalFile>guacamole-print-agent.min.css</cssFinalFile>
                                    <jsSourceDir>src/main/resources/js</jsSourceDir>
                                    <jsSourceIncludes>
                                        <include>**/*.js</include>
                                    </jsSourceIncludes>
                                    <jsTargetFile>guacamole-print-agent.min.js</jsTargetFile>
                                    <jsEngine>closure</jsEngine>
                                    <skipMerge>true</skipMerge>
                                    <cssSourceDir>src/main/resources/css</cssSourceDir>
                                    <cssTargetFile>guacamole-print-agent.min.css</cssTargetFile>
                                    <skipCssMerge>true</skipCssMerge>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>