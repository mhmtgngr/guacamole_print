FROM guacamole/guacamole:latest

# Switch to root to modify files
USER root

# Copy print extension resources
COPY guacamole-extension-module/src/main/resources/js/print-agent-client.js /tmp/print-agent-client.js
COPY guacamole-extension-module/src/main/resources/css/print-agent.css /tmp/print-agent.css

# Inject print agent script into WAR file
RUN cd /tmp && \
    mkdir -p war-extract && \
    cd war-extract && \
    jar xf /opt/guacamole/webapp/guacamole.war index.html && \
    sed -i 's|</body>|<script src="print-agent-client.js"></script></body>|' index.html && \
    jar uf /opt/guacamole/webapp/guacamole.war index.html && \
    rm -f index.html && \
    cd .. && \
    rm -rf war-extract && \
    mv /tmp/print-agent-client.js /opt/guacamole/webapp/ && \
    mv /tmp/print-agent.css /opt/guacamole/webapp/

# Create startup script to copy print agent files to deployed webapp
RUN echo '#!/bin/bash\n\
# Start Guacamole with original entrypoint in background\n\
/opt/guacamole/bin/entrypoint.sh &\n\
TOMCAT_PID=$!\n\
# Wait for webapp to be deployed\n\
echo "Waiting for Guacamole to deploy..."\n\
sleep 15\n\
# Find the deployed webapp directory\n\
for CATALINA_BASE in /tmp/catalina-base.*; do\n\
  if [ -f "$CATALINA_BASE/webapps/guacamole/index.html" ]; then\n\
    echo "Found Guacamole webapp at: $CATALINA_BASE/webapps/guacamole"\n\
    # Copy print agent files if they don\'t exist\n\
    if [ ! -f "$CATALINA_BASE/webapps/guacamole/print-agent-client.js" ]; then\n\
      cp /opt/guacamole/webapp/print-agent-client.js "$CATALINA_BASE/webapps/guacamole/"\n\
      cp /opt/guacamole/webapp/print-agent.css "$CATALINA_BASE/webapps/guacamole/"\n\
      echo "✅ Print agent files copied"\n\
    else\n\
      echo "ℹ️ Print agent files already exist"\n\
    fi\n\
    break\n\
  fi\ndone\n\
# Wait for Tomcat process\n\
wait $TOMCAT_PID\n' > /opt/guacamole/start-with-print.sh && \
    chmod +x /opt/guacamole/start-with-print.sh

# Switch back to guacamole user
USER guacamole

# Set custom entrypoint
ENTRYPOINT ["/opt/guacamole/start-with-print.sh"]

# Expose port 8080
EXPOSE 8080
