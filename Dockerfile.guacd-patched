# Custom guacd Dockerfile - Patched to fix XLSX truncation issue
# Use official guacamole/guacd:1.6.0 and patch the installed binary

FROM guacamole/guacd:1.6.0

# Create Download directory with correct permissions
RUN mkdir -p /tmp/guac-drive/Download && \
    chmod 777 /tmp/guac-drive/Download

# Note: We cannot easily patch the pre-compiled binary.
# The file deletion issue is in rdpdr-fs-messages.c:guac_rdpdr_fs_process_close()
# For now, this image just ensures directory exists with correct permissions.
